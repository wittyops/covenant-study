# ── Covenant Study — environment template ─────────────────────────────────────
# Copy to .env and fill in values for your deployment.
# .env is never committed — only this example file is tracked.

# ── Lab deployment (wittycomp-lab / witty_vlan30) ─────────────────────────────
# VLAN30 IP assigned to the container via macvlan.
APP_IP=10.10.30.246

# ── Standalone deployment (infra/compose.standalone.yml) ──────────────────────
# The admin account is auto-created on first run using these credentials.
# Change ADMIN_PASSWORD to something strong before exposing the port.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme
